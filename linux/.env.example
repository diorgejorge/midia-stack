# Copie para ".env" na pasta do docker-compose.yml e ajuste.

# Pasta com as bibliotecas de mídia (vira /data nos containers). Dentro dela: series, filmes, downloads.
PASTA_MIDIA=/srv/midia

# Usuário e grupo donos da pasta de mídia (veja com o comando `id`).
PUID=1000
PGID=1000

# Fuso horário (formato IANA).
TZ=America/Sao_Paulo
